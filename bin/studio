#!/bin/sh

set -eu

CLI_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
TEMPLATE_ROOT="${CLI_ROOT}/templates/wrapper"

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

info() {
    printf '%s\n' "$*"
}

usage() {
    cat <<'EOF'
Usage:
  studio new NAME [options]
  studio attach WRAPPER_ROOT REPOSITORY_PATH
  studio doctor WRAPPER_ROOT
  studio open WRAPPER_ROOT [--dry-run|--launch]

Commands:
  new       create an iCloud-first project and optionally its private wrapper
  attach    attach a canonical local Git repository to a wrapper
  doctor    validate a wrapper's storage boundaries
  open      show or open a wrapper's project surfaces

Options for new:
  --category companies|ventures
  --cloud-root PATH
  --with-wrapper
  --wrapper-root PATH
EOF
}

version() {
    cat "${CLI_ROOT}/VERSION"
}

slugify() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed 's/[^a-z0-9]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//'
}

shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

create_cloud_project() {
    cloud_root=$1

    mkdir -p "$cloud_root"
    for folder in Notes References Assets Exports Private; do
        mkdir -p "$cloud_root/$folder"
    done
}

wrapper_is_empty_or_missing() {
    wrapper_root=$1
    [ ! -e "$wrapper_root" ] && return 0
    [ -d "$wrapper_root" ] || return 1
    [ -z "$(find "$wrapper_root" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]
}

create_wrapper() {
    wrapper_root=$1
    project_name=$2
    cloud_root=$3

    wrapper_is_empty_or_missing "$wrapper_root" || die "wrapper path is not empty: ${wrapper_root}"
    mkdir -p "$wrapper_root"
    cp -R "$TEMPLATE_ROOT"/. "$wrapper_root"/

    project_name_quoted=$(shell_quote "$project_name")
    cloud_root_quoted=$(shell_quote "$cloud_root")
    cat > "$wrapper_root/config/project.env" <<EOF
# Generated by studio. Machine-specific; do not commit.
PROJECT_NAME=${project_name_quoted}
COMPANY_REPO=""
CLOUD_ROOT=${cloud_root_quoted}
CLOUD_LINK="\${PROJECT_ROOT}/remote/iCloud"
REPO_LINK="\${PROJECT_ROOT}/local/repo"
EOF

    "$wrapper_root/bin/bootstrap"
}

cmd_new() {
    [ "$#" -gt 0 ] || die "studio name is required"
    project_name=$1
    shift

    [ -n "$project_name" ] || die "studio name cannot be empty"
    case "$project_name" in
        */*) die "studio name cannot contain '/': ${project_name}" ;;
    esac

    category=companies
    cloud_root=''
    with_wrapper=0
    wrapper_root=''

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --category)
                shift
                [ "$#" -gt 0 ] || die "--category requires companies or ventures"
                category=$1
                ;;
            --cloud-root)
                shift
                [ "$#" -gt 0 ] || die "--cloud-root requires a path"
                cloud_root=$1
                ;;
            --with-wrapper) with_wrapper=1 ;;
            --wrapper-root)
                shift
                [ "$#" -gt 0 ] || die "--wrapper-root requires a path"
                wrapper_root=$1
                with_wrapper=1
                ;;
            -h|--help) usage; exit 0 ;;
            *) die "unknown option for new: $1" ;;
        esac
        shift
    done

    slug=$(slugify "$project_name")
    [ -n "$slug" ] || die "studio name must contain letters or numbers"

    if [ -z "$cloud_root" ]; then
        case "$category" in
            companies) cloud_base="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/SuuSoJeat/Career/Companies" ;;
            ventures) cloud_base="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/SuuSoJeat/Ventures/Software" ;;
            *) die "category must be companies or ventures" ;;
        esac
        cloud_root="${cloud_base}/${project_name}"
    fi

    create_cloud_project "$cloud_root"
    info "Created or confirmed iCloud project: ${cloud_root}"

    if [ "$with_wrapper" -eq 1 ]; then
        if [ -z "$wrapper_root" ]; then
            wrapper_root="${HOME}/Repositories/personal/${slug}-context"
        fi
        create_wrapper "$wrapper_root" "$project_name" "$cloud_root"
        info "Created private wrapper: ${wrapper_root}"
    else
        info "No wrapper created. Add one later with --with-wrapper."
    fi
}

cmd_attach() {
    [ "$#" -eq 2 ] || die "usage: studio attach WRAPPER_ROOT REPOSITORY_PATH"
    wrapper_root=$1
    repository_path=$2
    [ -x "$wrapper_root/bin/bootstrap" ] || die "wrapper bootstrap not found: ${wrapper_root}"
    "$wrapper_root/bin/bootstrap" --attach-repo "$repository_path"
}

cmd_doctor() {
    [ "$#" -eq 1 ] || die "usage: studio doctor WRAPPER_ROOT"
    wrapper_root=$1
    [ -x "$wrapper_root/bin/doctor" ] || die "wrapper doctor not found: ${wrapper_root}"
    "$wrapper_root/bin/doctor"
}

cmd_open() {
    [ "$#" -ge 1 ] || die "usage: studio open WRAPPER_ROOT [--dry-run|--launch]"
    wrapper_root=$1
    shift
    [ -x "$wrapper_root/bin/open-project" ] || die "wrapper open-project not found: ${wrapper_root}"
    "$wrapper_root/bin/open-project" "$@"
}

[ "$#" -gt 0 ] || { usage >&2; exit 1; }

command=$1
shift
case "$command" in
    new) cmd_new "$@" ;;
    attach) cmd_attach "$@" ;;
    doctor) cmd_doctor "$@" ;;
    open) cmd_open "$@" ;;
    --version|-V) version ;;
    -h|--help) usage ;;
    *) usage >&2; die "unknown command: ${command}" ;;
esac
