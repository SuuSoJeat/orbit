#!/bin/sh

set -eu

CLI_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
TEMPLATE_ROOT="${CLI_ROOT}/templates/wrapper"
CLI_CONFIG_FILE=''

# CLI helpers are split by ownership; generated wrappers receive only their runtime.
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/common.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/wrapper_runtime.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/wrapper_contract.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/config.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/creation.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/journal.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/selection.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/wrapper.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/project.sh"
# shellcheck disable=SC1091
. "${CLI_ROOT}/bin/lib/commands.sh"

usage() {
    cat <<'EOF'
Usage:
  orbit [--config PATH] config init|show|check
  orbit new [PROJECT_NAME] [options]
  orbit undo
  orbit attach [WRAPPER_ROOT] [--name NAME] REPOSITORY_PATH...
  orbit doctor [WRAPPER_ROOT]
  orbit open [WRAPPER_ROOT] [--dry-run|--launch]

Commands:
  config    create or inspect the consumer configuration
  new       create an iCloud project and optionally its local wrapper
  undo      remove a previously recorded project creation
  attach    attach one or more canonical local Git repositories to a wrapper
  doctor    validate a wrapper's storage boundaries
  open      show or open a wrapper's project locations

Options for new:
  --category companies|ventures
  --company NAME
  --client NAME
  --no-client
  --icloud-root PATH
  --with-wrapper
  --wrapper-root PATH

Global options:
  --config PATH  use an alternate consumer configuration file

Attach options:
  --name NAME    name one attached repository; defaults to its folder name
EOF
}

version() {
    cat "${CLI_ROOT}/VERSION"
}

if [ "$#" -gt 0 ] && [ "$1" = "--config" ]; then
    shift
    [ "$#" -gt 0 ] || die "--config requires a path"
    CLI_CONFIG_FILE=$1
    shift
fi

[ "$#" -gt 0 ] || { usage >&2; exit 1; }

command=$1
shift
case "$command" in
    config) cmd_config "$@" ;;
    new) cmd_new "$@" ;;
    undo) cmd_undo "$@" ;;
    attach) cmd_attach "$@" ;;
    doctor) cmd_doctor "$@" ;;
    open) cmd_open "$@" ;;
    --version|-V) version ;;
    -h|--help) usage ;;
    *) usage >&2; die "unknown command: ${command}" ;;
esac
