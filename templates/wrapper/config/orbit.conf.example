# This file is copied to config/orbit.conf by Orbit.
# Values are plain text; do not add shell syntax or environment expansion.

project_name = Example Project

# Optional until repositories are attached. The section name is also the
# symlink name below local/repo/.
#
# [repository "product"]
# path = /path/to/canonical/repository

# This is resolved when the wrapper is created and is intentionally local.
icloud_project_path = /path/to/consumer/iCloud/project

# Orbit derives remote/iCloud and local/repo/<repository-name> links from the
# wrapper root.
