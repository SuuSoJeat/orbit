# This file is copied to config/project.env by bin/bootstrap.
# PROJECT_ROOT is supplied by the wrapper scripts before this file is sourced.

PROJECT_NAME="Example Studio"

# Optional until a repository is attached. The canonical repository must live
# outside this wrapper, normally somewhere below ~/Repositories.
COMPANY_REPO=""

# Change the category or project name here if this belongs under Ventures/Software.
CLOUD_ROOT="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/SuuSoJeat/Career/Companies/Example Studio"

# These are local-only convenience links and must not be synced.
CLOUD_LINK="${PROJECT_ROOT}/remote/iCloud"
REPO_LINK="${PROJECT_ROOT}/local/repo"
