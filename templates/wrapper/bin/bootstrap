#!/bin/sh

set -eu

# shellcheck disable=SC1091
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/lib.sh"

DEMO=0
ATTACH_REPO=""

usage() {
    cat <<'EOF'
Usage: ./bin/bootstrap [--demo] [--attach-repo PATH]

Prepare the iCloud-first project, local wrapper, and optional repo attachment.

  --demo                 create an independent canonical repo for a safe trial
  --attach-repo PATH     attach an existing canonical repository
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --demo) DEMO=1 ;;
        --attach-repo)
            shift
            [ "$#" -gt 0 ] || die "--attach-repo requires a path"
            ATTACH_REPO=$1
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; die "unknown option: $1" ;;
    esac
    shift
done

if [ ! -f "$CONFIG_FILE" ]; then
    cp "${PROJECT_ROOT}/config/project.env.example" "$CONFIG_FILE"
    info "Created ${CONFIG_FILE}"
fi

set_config_value() {
    key=$1
    value=$2
    tmp_file="${CONFIG_FILE}.tmp.$$"

    awk -v key="$key" -v value="$value" '
        BEGIN { replacement = key "=\"" value "\""; found = 0 }
        $0 ~ "^[[:space:]]*" key "=" { print replacement; found = 1; next }
        { print }
        END { if (!found) print replacement }
    ' "$CONFIG_FILE" > "$tmp_file"
    mv "$tmp_file" "$CONFIG_FILE"
}

if [ -n "$ATTACH_REPO" ]; then
    set_config_value COMPANY_REPO "$ATTACH_REPO"
fi

load_config

if [ ! -d "${PROJECT_ROOT}/.git" ]; then
    git -C "$PROJECT_ROOT" init >/dev/null
    info "Initialized wrapper Git repository"
fi

mkdir -p "$PROJECT_ROOT/local" "$PROJECT_ROOT/remote"

if [ "$DEMO" -eq 1 ]; then
    if [ -z "$COMPANY_REPO" ]; then
        REPOSITORIES_PARENT=$(CDPATH= cd -P -- "${PROJECT_ROOT}/.." && pwd -P)
        COMPANY_REPO="${REPOSITORIES_PARENT}/studio-company-app"
        set_config_value COMPANY_REPO "$COMPANY_REPO"
        load_config
    fi

    if [ -e "$COMPANY_REPO" ] && [ ! -d "$COMPANY_REPO/.git" ]; then
        die "demo path exists but is not an independent Git repository: ${COMPANY_REPO}"
    fi

    if [ ! -e "$COMPANY_REPO" ]; then
        mkdir -p "$COMPANY_REPO"
        git -C "$COMPANY_REPO" init >/dev/null
        printf '# Demo Company App\n\nThis is an isolated fixture for Studio.\n' > "$COMPANY_REPO/README.md"
        git -C "$COMPANY_REPO" add README.md
        git -C "$COMPANY_REPO" -c user.name='Studio' -c user.email='studio@example.invalid' commit -m 'Initialize demo company app' >/dev/null
        info "Created canonical demo repository at ${COMPANY_REPO}"
    fi
fi

if [ ! -d "$CLOUD_ROOT" ]; then
    mkdir -p "$CLOUD_ROOT"
    info "Created cloud project directory at ${CLOUD_ROOT}"
fi

for folder in Notes References Assets Exports Private; do
    mkdir -p "$CLOUD_ROOT/$folder"
done

ensure_link() {
    link_path=$1
    target_path=$2
    label=$3

    if [ -e "$link_path" ] || [ -L "$link_path" ]; then
        [ -L "$link_path" ] || die "refusing to replace non-symlink at ${link_path}"
        LINK_TARGET=$(physical_dir "$link_path") || die "${label} symlink is broken: ${link_path}"
        TARGET_DIR=$(physical_dir "$target_path") || die "${label} target is not accessible: ${target_path}"
        [ "$LINK_TARGET" = "$TARGET_DIR" ] || die "${label} symlink points to ${LINK_TARGET}, expected ${TARGET_DIR}"
    else
        ln -s "$target_path" "$link_path"
        info "Created ${label} boundary symlink at ${link_path}"
    fi
}

ensure_link "$CLOUD_LINK" "$CLOUD_ROOT" cloud

if [ -n "$COMPANY_REPO" ] && [ -d "$COMPANY_REPO" ]; then
    ensure_link "$REPO_LINK" "$COMPANY_REPO" repository
elif [ -n "$COMPANY_REPO" ]; then
    info "Repository attachment is configured but not present yet: ${COMPANY_REPO}"
else
    info "No company repository attached yet; the iCloud project can start independently."
fi

info "Bootstrap complete. Run ./bin/doctor."
