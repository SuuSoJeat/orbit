#!/bin/sh

set -eu

# shellcheck disable=SC1091
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)/lib.sh"
load_config

FAILURES=0

run_check() {
    CHECK_LABEL="$1"
    shift
    if ! check_result "$@"; then
        FAILURES=$((FAILURES + 1))
    fi
}

wrapper_is_git_repo() {
    [ "$(git -C "$PROJECT_ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$PROJECT_ROOT" ]
}

repository_is_git_repo() {
    [ -d "$REPOSITORY_PATH" ] || return 1
    REPOSITORY_TOP=$(git -C "$REPOSITORY_PATH" rev-parse --show-toplevel 2>/dev/null) || return 1
    REPOSITORY_PHYSICAL=$(physical_dir "$REPOSITORY_PATH") || return 1
    [ "$REPOSITORY_TOP" = "$REPOSITORY_PHYSICAL" ]
}

repo_link_is_ignored() {
    RELATIVE_REPO_LINK=$(relative_to_root "$REPO_LINK") || return 1
    git -C "$PROJECT_ROOT" check-ignore -q -- "$RELATIVE_REPO_LINK"
}

icloud_project_is_directory() {
    [ -d "$ICLOUD_PROJECT_PATH" ]
}

icloud_project_link_is_correct() {
    [ -L "$ICLOUD_PROJECT_LINK" ] || return 1
    [ "$(physical_dir "$ICLOUD_PROJECT_LINK")" = "$(physical_dir "$ICLOUD_PROJECT_PATH")" ]
}

repo_link_is_correct() {
    [ -n "$REPOSITORY_PATH" ] || return 1
    [ -L "$REPO_LINK" ] || return 1
    [ "$(physical_dir "$REPO_LINK")" = "$(physical_dir "$REPOSITORY_PATH")" ]
}

repository_is_outside_wrapper() {
    REPOSITORY_PHYSICAL=$(physical_dir "$REPOSITORY_PATH") || return 1
    WRAPPER_PHYSICAL=$(physical_dir "$PROJECT_ROOT") || return 1
    case "$REPOSITORY_PHYSICAL/" in
        "$WRAPPER_PHYSICAL"/*) return 1 ;;
        *) return 0 ;;
    esac
}

icloud_project_has_no_git_metadata() {
    [ -z "$(find "$ICLOUD_PROJECT_PATH" -name .git -print -prune 2>/dev/null)" ]
}

icloud_project_has_no_dependencies() {
    [ -z "$(find "$ICLOUD_PROJECT_PATH" -name node_modules -print -prune 2>/dev/null)" ]
}

repository_is_outside_icloud_project() {
    REPOSITORY_PHYSICAL=$(physical_dir "$REPOSITORY_PATH") || return 1
    ICLOUD_PROJECT_PHYSICAL=$(physical_dir "$ICLOUD_PROJECT_PATH") || return 1
    case "$REPOSITORY_PHYSICAL/" in
        "$ICLOUD_PROJECT_PHYSICAL"/*) return 1 ;;
        *) return 0 ;;
    esac
}

printf 'Orbit project health check\n\n'
run_check "wrapper is a Git repository" wrapper_is_git_repo
run_check "iCloud project directory exists" icloud_project_is_directory
run_check "iCloud project link resolves correctly" icloud_project_link_is_correct
run_check "iCloud project contains no .git directories" icloud_project_has_no_git_metadata
run_check "iCloud project contains no node_modules directories" icloud_project_has_no_dependencies

if [ -z "$REPOSITORY_PATH" ]; then
    printf 'INFO repository is not attached yet (optional)\n'
else
    run_check "repository exists independently" repository_is_git_repo
    run_check "repository is outside wrapper" repository_is_outside_wrapper
    run_check "repository link is ignored by wrapper" repo_link_is_ignored
    run_check "repository link resolves correctly" repo_link_is_correct
    run_check "repository is outside iCloud project" repository_is_outside_icloud_project
fi

if [ "$FAILURES" -ne 0 ]; then
    printf '\n%d check(s) failed.\n' "$FAILURES" >&2
    exit 1
fi

printf '\nAll checks passed.\n'
